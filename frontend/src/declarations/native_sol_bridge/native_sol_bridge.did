type VerifyForwardResponse = 
 variant {
   err: CommonError;
   ok: Summary;
 };
type Verified = 
 record {
   event: Event;
   forward: Descriptor;
   slot: nat64;
   tx_version: TxVersion;
 };
type Unverifiable = 
 variant {
   Disagreement;
   Inconsistent;
   NotFinalized;
   NotFound;
   ProviderError: text;
   Undecodable: text;
   UnsupportedSchema: nat;
   UnsupportedTransactionVersion: opt nat8;
 };
type TxVersion = 
 variant {
   legacy;
   v0;
 };
type SupportedProvider = 
 variant {
   AlchemyDevnet;
   AlchemyMainnet;
   AnkrDevnet;
   AnkrMainnet;
   ChainstackDevnet;
   ChainstackMainnet;
   DrpcDevnet;
   DrpcMainnet;
   HeliusDevnet;
   HeliusMainnet;
   PublicNodeMainnet;
 };
type Summary = 
 record {
   binding: Binding;
   cursor: nat;
   seq: nat;
   status: Status;
 };
type SubmitResult = 
 variant {
   Duplicate: record {
                same_descriptor: bool;
                seq: nat;
                status: Status;
              };
   Malformed: text;
   Submitted: record {seq: nat;};
 };
type SubmitResponse = 
 variant {
   err: variant {
          NotConfigured;
          NotRelayer;
          Rejected: text;
        };
   ok: SubmitResult;
 };
type Status = 
 variant {
   Forwarded:
    record {
      already_observed: bool;
      at: nat64;
      obligation_id: ObligationId;
    };
   Invalid: record {
              at: nat64;
              reason: RejectReason;
            };
   Pending;
   Quarantined: record {
                  at: nat64;
                  reason: text;
                };
   Unverified: record {
                 attempts: nat;
                 last_at: nat64;
                 reason: Unverifiable;
               };
   Verified: record {
               last_at: nat64;
               last_reason: opt text;
               retries: nat;
             };
 };
type SolanaCluster = 
 variant {
   Devnet;
   Mainnet;
   Testnet;
 };
type SeriesAFunded = 
 record {
   close_id: opt nat64;
   entitlement_after: nat;
   gross: nat64;
   owner: text;
   round_id: nat64;
   schema_version: nat8;
 };
type RpcSources = 
 variant {
   Custom: vec RpcSource;
   Default: SolanaCluster;
 };
type RpcSource = 
 variant {
   Custom: RpcEndpoint;
   Supported: SupportedProvider;
 };
type RpcEndpoint = 
 record {
   headers: opt vec HttpHeader;
   url: text;
 };
type RoundFinalized = 
 record {
   close_id: nat64;
   new_round: nat64;
   schema_version: nat8;
   seed_carried: nat64;
 };
type ReleaseResponse = 
 variant {
   err: variant {
          Cooldown: nat64;
          NotConfigured;
          NotForwarded;
          UnknownEvent;
        };
   ok: record {
         binding: Binding;
         shenanigans: opt BindResult;
       };
 };
type RejectReason = 
 variant {
   BasisMismatch;
   CloseMismatch;
   ClusterMismatch;
   ForgedEventAuthority;
   ForgedProgramId;
   InvalidAccountIndex;
   KindMismatch;
   MalformedEvent: text;
   NotEventCpi;
   NotInnerCpi;
   OuterProgramMismatch;
   OwnerNotSigner;
   PlanMismatch;
   ProgramIdMismatch;
   RecipientMismatch;
   RoundMismatch;
   SchemaMismatch;
   SignatureMismatch;
   TransactionFailed;
   UnknownEvent;
   WrongAncestry;
 };
type PublicConfig = 
 record {
   cluster_domain: blob;
   event_authority: text;
   program_id: text;
   shenanigans: principal;
   supported_schema_versions: vec nat;
 };
type PromotionApplied = 
 record {
   close_id: opt nat64;
   entitlement: nat;
   loss: nat64;
   round_id: nat64;
   schema_version: nat8;
   winner: text;
 };
type PositionOpened = 
 record {
   close_id: opt nat64;
   config_version: nat32;
   gross: nat64;
   load: nat64;
   nonce: nat64;
   owner: text;
   plan: nat8;
   round_id: nat64;
   schema_version: nat8;
 };
type Plan = 
 variant {
   Compound15;
   Compound30;
   Simple;
 };
type PayoutPaid = 
 record {
   close_id: opt nat64;
   closing: bool;
   destination: text;
   gross_paid: nat64;
   net: nat64;
   nonce: nat64;
   owner: text;
   round_id: nat64;
   schema_version: nat8;
   ticket_id: nat64;
   toll: nat64;
 };
type OtherEvent = 
 record {
   body: blob;
   name: text;
   schema_version: nat8;
 };
type ObligationId = text;
type Kind = 
 variant {
   PositionOpened;
   PromotionApplied;
   SeriesAFunded;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type EventId = 
 record {
   cluster_domain: blob;
   event_schema_version: nat;
   inner_instruction_index: nat;
   instruction_index: nat;
   program_id: text;
   signature: text;
 };
type Event = 
 variant {
   BackerClaimed: BackerClaimed;
   Other: OtherEvent;
   PayoutPaid: PayoutPaid;
   PositionOpened: PositionOpened;
   PromotionApplied: PromotionApplied;
   RoundFinalized: RoundFinalized;
   SeriesAFunded: SeriesAFunded;
 };
type Entry = 
 record {
   binding: Binding;
   descriptor: Descriptor;
   event_key: text;
   next_attempt_at: nat64;
   seq: nat;
   status: Status;
   submitted_at: nat64;
   submitted_by: principal;
   verified: opt Verified;
 };
type Descriptor = 
 record {
   basis_lamports: nat64;
   beneficiary_pubkey: text;
   event_id: EventId;
   kind: Kind;
   plan: opt Plan;
   source_close_id: opt nat64;
   source_round_id: nat64;
 };
type Config = 
 record {
   cluster_domain: blob;
   event_authority: text;
   program_id: text;
   rpc_a: RpcSources;
   rpc_b: RpcSources;
   shenanigans: principal;
   supported_schema_versions: vec nat;
 };
type CommonError = 
 variant {
   Cooldown: nat64;
   NotConfigured;
   UnknownEvent;
 };
type Binding = 
 variant {
   Bound: record {at: nat64;};
   Unbound;
 };
type BindResult = 
 variant {
   AlreadyReserved;
   Rejected: text;
   Reserved;
   Unbound;
   UnknownEvent;
 };
type BackerClaimed = 
 record {
   a_part: nat64;
   amount: nat64;
   b_part: nat64;
   owner: text;
   round_id: nat64;
   schema_version: nat8;
 };
service : {
  getConfig: () -> (opt PublicConfig) query;
  /// Every entry with seq <= cursor is durable-done (forwarded, quarantined
  /// or provably invalid). A gap (e.g. unsupported transaction version)
  /// holds it back.
  getCursor: () -> (nat) query;
  getEvent: (eventId: EventId) -> (opt Entry) query;
  /// Open (cursor-blocking) entries with seq > `after`, oldest first; pass
  /// `getCursor()` to see exactly what holds the cursor back.
  getPending: (after: nat, limit: nat) -> (vec Entry) query;
  /// Newest-first page of the verified-event store (`before`: seq bound).
  getRecentEvents: (before: opt nat, limit: nat) -> (vec Entry) query;
  getRelayers: () -> (vec principal) query;
  /// Forwarded events whose beneficiary has no SIWS binding yet.
  getUnbound: (pubkey: text) -> (vec Entry) query;
  /// For an event Shenanigans already holds as Observed: ask it to bind the
  /// beneficiary pubkey to a principal and reserve the legs. `#Unbound`
  /// leaves the event pubkey-keyed (retry after the user signs in with that
  /// wallet); the cursor is not involved either way.
  releasePending: (eventId: EventId) -> (ReleaseResponse);
  setConfig: (c: Config) -> (variant {
                               err: text;
                               ok;
                             });
  setRelayers: (ps: vec principal) -> (variant {
                                         err: text;
                                         ok;
                                       });
  /// Relayer-authenticated. Descriptors that contradict this canister's own
  /// configuration (wrong cluster/program) are refused without being stored.
  submitEventDescriptor: (d: Descriptor) -> (SubmitResponse);
  /// Drive one event as far as it will go: verify (two RPC calls) if not yet
  /// verified, then `observeNativeEvent` (one Shenanigans call) if verified.
  /// Idempotent and safe to call concurrently: every state write goes
  /// through a guarded transition, and a per-event cooldown (persisted
  /// before the first await) bounds the cycles a caller can burn.
  verifyAndForward: (eventId: EventId) -> (VerifyForwardResponse);
}
