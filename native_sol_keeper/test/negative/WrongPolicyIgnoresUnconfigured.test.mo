// NEGATIVE CONTROL (generated by negative.py - do not edit). Written AFTER the implementation.
// Subject: WrongPolicyIgnoresUnconfigured - decide signs although the keeper is not configured
// This file is ../policy.test.mo with only its import paths changed and the subject module swapped
// for a VALID but deliberately wrong variant. It is EXPECTED to end with a "check(s) FAILED" trap and
// is not part of the real suite (run it with negative.py run, see README.md).
// Standalone tests for Policy: the pure watchdog decision (idle / alert / sign /
// blocked), the progress tracker, the alert level, the hourly signature budget,
// the polling cadence and the timer lifecycle (re-arm after upgrade).
//
// Run from the repo root (zsh: pass ${=MOC_SOURCES}):
//   $MOC -r ${=MOC_SOURCES} native_sol_keeper/test/policy.test.mo

import Debug "mo:base/Debug";

import Policy "WrongPolicyIgnoresUnconfigured";

var failures : Nat = 0;
func check(cond : Bool, msg : Text) {
  if (cond) { Debug.print("PASS: " # msg) } else { Debug.print("FAIL: " # msg); failures += 1 };
};

let S : Nat = 1_000_000_000; // ns per second
let T0 : Nat = 1_000_000 * S; // an arbitrary "now" base

func at(staleSecs : Nat) : Policy.Input {
  {
    now = T0;
    lastProgressAt = T0 - staleSecs * S;
    lastSignedAt = 0;
    alertAfterNs = 60 * S;
    signAfterNs = 300 * S;
    journalHasUnknown = false;
    configured = true;
  };
};
func isIdle(d : Policy.Decision) : Bool { switch (d) { case (#Idle) true; case (_) false } };
func isAlert(d : Policy.Decision) : Bool { switch (d) { case (#Alert) true; case (_) false } };
func isSign(d : Policy.Decision) : Bool { switch (d) { case (#Sign) true; case (_) false } };
func isBlocked(d : Policy.Decision) : Bool { switch (d) { case (#Blocked(_)) true; case (_) false } };

// =====================================================================
// signs_only_after_stale_progress_threshold
// =====================================================================
do {
  Debug.print("== signs_only_after_stale_progress_threshold ==");
  check(Policy.ALERT_AFTER_NS == 60 * S and Policy.SIGN_AFTER_NS == 300 * S, "defaults are the spec's 60 s alert and 300 s escalation");
  check(isIdle(Policy.decide(at(0))), "0 s of stale progress -> Idle");
  check(isIdle(Policy.decide(at(59))), "59 s -> Idle");
  check(isAlert(Policy.decide(at(60))), "60 s -> Alert");
  check(isAlert(Policy.decide(at(61))), "61 s -> Alert");
  check(isAlert(Policy.decide(at(299))), "299 s -> Alert (never Sign before the threshold)");
  check(isSign(Policy.decide(at(300))), "300 s -> Sign");
  check(isSign(Policy.decide(at(86_400))), "a day of stale progress -> Sign");

  switch (Policy.decide({ at(300) with journalHasUnknown = true })) {
    case (#Blocked(m)) { check(m == "unresolved unknown journal entry", "300 s with an unresolved unknown entry -> Blocked: " # m) };
    case (_) { check(false, "300 s with an unresolved unknown entry must be Blocked") };
  };
  check(isAlert(Policy.decide({ at(120) with journalHasUnknown = true })), "an unknown entry does not hide the Alert below the threshold");
  switch (Policy.decide({ at(300) with configured = false })) {
    case (#Blocked(m)) { check(m == "not configured", "not configured -> Blocked: " # m) };
    case (_) { check(false, "not configured must be Blocked") };
  };
  check(isBlocked(Policy.decide({ at(0) with configured = false })), "not configured is Blocked even with fresh progress");
  check(isIdle(Policy.decide({ at(0) with lastProgressAt = T0 + 5 * S })), "progress stamped in the future (clock skew) counts as zero staleness");
  check(isBlocked(Policy.decide({ at(300) with signAfterNs = 0 })), "signAfterNs = 0 is an invalid threshold, never an immediate Sign");
  check(isBlocked(Policy.decide({ at(300) with signAfterNs = 30 * S })), "signAfterNs below alertAfterNs is invalid -> Blocked");
  // Signing cool-down: after a signature the watchdog waits one alert interval for the result.
  check(isAlert(Policy.decide({ at(400) with lastSignedAt = T0 - 10 * S })), "signed 10 s ago -> Alert, not another Sign");
  check(isSign(Policy.decide({ at(400) with lastSignedAt = T0 - 61 * S })), "signed 61 s ago -> Sign is allowed again");
  check(isSign(Policy.decide({ at(400) with lastSignedAt = 0 })), "never signed -> Sign");
  check(Policy.staleFor(T0, T0 - 7 * S) == 7 * S and Policy.staleFor(T0, T0 + 1) == 0, "staleFor saturates at zero");
};

// =====================================================================
// rearms_timer_after_upgrade
// =====================================================================
do {
  Debug.print("== rearms_timer_after_upgrade ==");
  check(Policy.rearmAfterUpgrade({ armed = true; configured = true }), "armed + configured -> postupgrade re-arms");
  check(not Policy.rearmAfterUpgrade({ armed = false; configured = true }), "disarmed stays disarmed after an upgrade");
  check(not Policy.rearmAfterUpgrade({ armed = true; configured = false }), "armed but unconfigured has nothing to tick");

  // Lifecycle model: an upgrade drops live timers (they are not persisted); the stable `armed` flag survives.
  var s : Policy.TimerState = { armed = false; timerLive = false };
  func step(e : Policy.TimerEvent, configured : Bool) : Policy.TimerAction {
    let (next, action) = Policy.timerStep(s, configured, e);
    s := next;
    action;
  };
  func isStart(a : Policy.TimerAction) : Bool { switch (a) { case (#Start) true; case (_) false } };
  func isNone(a : Policy.TimerAction) : Bool { switch (a) { case (#None) true; case (_) false } };
  func isCancel(a : Policy.TimerAction) : Bool { switch (a) { case (#Cancel) true; case (_) false } };

  check(isNone(step(#Arm, false)) and not s.armed, "arming an unconfigured keeper is refused: no timer, flag unchanged");
  check(isStart(step(#Arm, true)) and s.armed and s.timerLive, "arm starts the timer and sets the stable flag");
  check(isNone(step(#Arm, true)) and s.timerLive, "arming twice never starts a second timer");
  check(isNone(step(#Upgrade, true)) and s.armed and not s.timerLive, "an upgrade drops the live timer but keeps the stable flag");
  check(isStart(step(#PostUpgrade, true)) and s.armed and s.timerLive, "postupgrade re-arms because the flag was set");
  check(isNone(step(#PostUpgrade, true)), "a second postupgrade with a live timer does nothing");
  check(isCancel(step(#Disarm, true)) and not s.armed and not s.timerLive, "disarm cancels the timer and clears the flag");
  check(isNone(step(#Disarm, true)), "disarming twice is a no-op");
  check(isNone(step(#Upgrade, true)) and isNone(step(#PostUpgrade, true)) and not s.timerLive, "after a disarm an upgrade does not resurrect the timer");
};

// =====================================================================
// progress tracker: own steps do not reset the stale clock
// =====================================================================
do {
  Debug.print("== tracker ==");
  let t0 : Policy.Tracker = Policy.newTracker(T0);
  check(t0.lastProgressAt == T0 and t0.marker == "", "a fresh tracker starts the clock at creation");

  // Nothing pending: the clock follows `now` (nothing can be stalled).
  let idle = Policy.observe(t0, "idle", false, T0 + 500 * S, false);
  check(idle.lastProgressAt == T0 + 500 * S and idle.marker == "idle", "no pending work resets the clock to now");

  // Work appears: first pending observation starts the clock.
  let w1 = Policy.observe(idle, "r1|t1.0.0", true, T0 + 600 * S, false);
  check(w1.lastProgressAt == T0 + 600 * S, "a new pending marker is progress (starts the clock)");

  // Same marker: unchanged progress time.
  let w2 = Policy.observe(w1, "r1|t1.0.0", true, T0 + 700 * S, false);
  check(w2.lastProgressAt == T0 + 600 * S and w2.observedAt == T0 + 700 * S, "an unchanged marker does not refresh the clock");

  // Foreign progress (someone else's step): resets the clock.
  let w3 = Policy.observe(w2, "r1|t1.0.8", true, T0 + 710 * S, false);
  check(w3.lastProgressAt == T0 + 710 * S, "marker changed with no own landed step -> foreign progress resets the clock");

  // Own landed step: marker changes but the stale clock keeps running (rescue continuity).
  let w4 = Policy.observe(w3, "r1|t1.0.16", true, T0 + 1_100 * S, true);
  check(w4.lastProgressAt == T0 + 710 * S and w4.lastOwnProgressAt == T0 + 1_100 * S, "marker changed because our step landed -> the stale clock is NOT reset");
  check(isSign(Policy.decide({ at(0) with now = T0 + 1_100 * S; lastProgressAt = w4.lastProgressAt; lastSignedAt = T0 + 1_000 * S })), "the watchdog keeps rescuing: still stale after its own landed step");

  // The primary comes back: its progress is foreign and ends the rescue.
  let w5 = Policy.observe(w4, "r1|t1.0.24", true, T0 + 1_160 * S, false);
  check(w5.lastProgressAt == T0 + 1_160 * S, "foreign progress after a rescue ends it");
};

// =====================================================================
// alert level + cadence + hourly budget
// =====================================================================
do {
  Debug.print("== level_cadence_budget ==");
  func lvl(pending : Bool, stale : Nat) : Policy.Level { Policy.level(pending, stale * S, 60 * S, 300 * S) };
  func isOk(l : Policy.Level) : Bool { switch (l) { case (#Ok) true; case (_) false } };
  func isAl(l : Policy.Level) : Bool { switch (l) { case (#Alert) true; case (_) false } };
  func isEs(l : Policy.Level) : Bool { switch (l) { case (#Escalate) true; case (_) false } };
  check(isOk(lvl(false, 10_000)), "no pending work is always Ok");
  check(isOk(lvl(true, 59)), "59 s stale -> Ok");
  check(isAl(lvl(true, 60)) and isAl(lvl(true, 299)), "60..299 s -> Alert");
  check(isEs(lvl(true, 300)) and isEs(lvl(true, 9_999)), ">= 300 s -> Escalate");

  check(isAl(Policy.escalateIfDead(#Ok, true, 500 * S, 120 * S)), "an armed keeper whose timer is silent is at least Alert");
  check(isOk(Policy.escalateIfDead(#Ok, true, 10 * S, 120 * S)) and isOk(Policy.escalateIfDead(#Ok, false, 500 * S, 120 * S)), "a live keeper, or one that is not armed, keeps its level");
  check(isEs(Policy.escalateIfDead(#Escalate, true, 500 * S, 120 * S)), "escalation is never lowered");

  check(Policy.pollDelayNs(true, 30 * S, 300 * S) == 30 * S, "work pending polls at the active interval");
  check(Policy.pollDelayNs(false, 30 * S, 300 * S) == 300 * S, "no work polls at the idle interval");
  check(Policy.due(T0, T0) and Policy.due(T0 + 1, T0) and not Policy.due(T0 - 1, T0), "due() is inclusive of nextPollAt");

  let hour : Nat = 3_600 * S;
  let times = [T0 - 7_200 * S, T0 - 3_599 * S, T0 - 10 * S];
  check(Policy.signaturesInWindow(times, T0, hour) == 2, "signatures older than an hour fall out of the window");
  check(Policy.budgetAllows(times, T0, hour, 3), "2 of 3 used -> allowed");
  check(not Policy.budgetAllows(times, T0, hour, 2), "2 of 2 used -> refused");
  check(not Policy.budgetAllows([], T0, hour, 0), "a zero budget never signs");
  check(Policy.pruneWindow(times, T0, hour).size() == 2, "pruneWindow drops expired stamps");
};

if (failures > 0) { Debug.trap("WrongPolicyIgnoresUnconfigured.test.mo (negative control of policy.test.mo): " # debug_show (failures) # " check(s) FAILED") };
Debug.print("WrongPolicyIgnoresUnconfigured.test.mo (negative control of policy.test.mo): ALL PASS");
