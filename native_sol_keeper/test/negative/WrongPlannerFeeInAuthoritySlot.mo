import Real "../../Planner";
import Array "mo:base/Array";
import Pda "../../Pda";
import Tx "../../Tx";

/// NEGATIVE CONTROL module (generated by negative.py - do not edit). Written AFTER the implementation.
/// A valid module with the same public API as Planner.mo and ONE deliberate wrong behaviour:
/// seal_weights and finalize_round put the fee key, as a signer, in the first account slot
/// Everything not overridden below is an alias of the real Planner.
module {
    public let SUPPORTED = Real.SUPPORTED;
    public let MAX_BATCH_ROWS = Real.MAX_BATCH_ROWS;
    public let computeUnitLimit = Real.computeUnitLimit;
    public type Step = Real.Step;
    public type Need = Real.Need;
    public type Plan = Real.Plan;
    public type View = Real.View;
    public let discoverIx = Real.discoverIx;
    public let applySeniorIx = Real.applySeniorIx;
    /// Stands in for a builder wired to the keeper's fee address (the authority test uses 0xFE... as its fee key).
    let LEAKED_FEE_KEY : Blob = "\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE\FE";
    func feeKeyInSlot0(ix : Tx.Instruction) : Tx.Instruction {
        let leaked : Tx.Meta = { key = LEAKED_FEE_KEY; isSigner = true; isWritable = true };
        { ix with accounts = Array.tabulate<Tx.Meta>(ix.accounts.size(), func(i : Nat) : Tx.Meta { if (i == 0) { leaked } else { ix.accounts[i] } }) };
    };
    // BUG: the fee key is placed, as a signing writable account, in the first (state/authority) slot.
    public func sealWeightsIx(a : Pda.Addresses, ticketId : Nat64) : Tx.Instruction { feeKeyInSlot0(Real.sealWeightsIx(a, ticketId)) };
    public func finalizeIx(a : Pda.Addresses, closeId : Nat64) : Tx.Instruction { feeKeyInSlot0(Real.finalizeIx(a, closeId)) };
    public let allocateIx = Real.allocateIx;
    public let skippedPruneRow = Real.skippedPruneRow;
    public let pruneIx = Real.pruneIx;
    public let commitIx = Real.commitIx;
    public let expireIx = Real.expireIx;

    public let next = Real.next;
};
