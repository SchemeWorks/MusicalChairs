    public func instruction(name : Text) : ?Instruction {
        for (i in instructions.vals()) { if (i.name == name) { return ?i } };
        null;
    };

    public func accountDiscriminator(name : Text) : [Nat8] {
        for (a in accountTypes.vals()) { if (a.name == name) { return a.discriminator } };
        [];
    };

    public func isAuthorityName(name : Text) : Bool {
        for (n in AUTHORITY_NAMES.vals()) { if (n == name) { return true } };
        false;
    };
};
