// NEGATIVE CONTROL (generated by negative.py - do not edit). Written AFTER the implementation.
// Subject: WrongAuthorityTablePayerIsAuthority - the generated authority table marks every payer account as an authority
// This file is ../authority.test.mo with only its import paths changed and the subject module swapped
// for a VALID but deliberately wrong variant. It is EXPECTED to end with a "check(s) FAILED" trap and
// is not part of the real suite (run it with negative.py run, see README.md).
// Static authority checks: the fee address never holds program authority.
//
//  1. Over AuthorityTable (generated from the program IDL): no instruction marks
//     a `payer` / `fee_payer` account as authority, every signer is classified,
//     and the instructions with a `payer` are exactly the page/close/draw ones.
//  2. Over the keeper's step builders: every instruction the watchdog can emit
//     has NO signer account and NO authority account in the IDL, and when the
//     steps are compiled into a transaction the fee address appears exactly once,
//     as the message fee payer (account 0), and in no instruction account list.
//
// Run from the repo root (zsh: pass ${=MOC_SOURCES}):
//   $MOC -r ${=MOC_SOURCES} native_sol_keeper/test/authority.test.mo

import Array "mo:base/Array";
import Blob "mo:base/Blob";
import Debug "mo:base/Debug";
import Nat8 "mo:base/Nat8";

import AuthorityTable "WrongAuthorityTablePayerIsAuthority";
import Base58 "../../Base58";
import Pda "../../Pda";
import Planner "../../Planner";
import Tx "../../Tx";

var failures : Nat = 0;
func check(cond : Bool, msg : Text) {
  if (cond) { Debug.print("PASS: " # msg) } else { Debug.print("FAIL: " # msg); failures += 1 };
};
func contains(xs : [Text], x : Text) : Bool {
  for (y in xs.vals()) { if (y == x) { return true } };
  false;
};
func key(b : Nat8) : Blob { Blob.fromArray(Array.tabulate<Nat8>(32, func _ { b })) };

// =====================================================================
// fee_address_has_no_program_authority
// =====================================================================
do {
  Debug.print("== fee_address_has_no_program_authority ==");

  // ---- 1. the generated table ------------------------------------------------
  check(AuthorityTable.instructions.size() == 36, "the table covers all 36 program instructions");
  var payerNamed : Nat = 0;
  var payerAsAuthority : Nat = 0;
  var unclassifiedSigners : [Text] = [];
  var authorityAccounts : Nat = 0;
  var payerInstructions : [Text] = [];
  for (ix in AuthorityTable.instructions.vals()) {
    for (a in ix.accounts.vals()) {
      if (a.isAuthority) { authorityAccounts += 1 };
      if (a.name == "payer" or a.name == "fee_payer") {
        payerNamed += 1;
        if (a.isAuthority) { payerAsAuthority += 1 };
        payerInstructions := Array.append(payerInstructions, [ix.name]);
      };
      if (a.isSigner and not a.isAuthority and not contains(AuthorityTable.NON_AUTHORITY_SIGNERS, a.name)) {
        unclassifiedSigners := Array.append(unclassifiedSigners, [ix.name # "." # a.name]);
      };
      if (a.isAuthority and not a.isSigner) { failures += 1; Debug.print("FAIL: a non-signer is marked authority: " # ix.name # "." # a.name) };
    };
  };
  check(payerNamed == 4, "exactly four payer positions exist in the program");
  check(payerAsAuthority == 0, "no payer / fee_payer account is marked authority");
  check(unclassifiedSigners.size() == 0, "every signer is an authority or an accepted non-authority signer (payer, sender)");
  check(authorityAccounts >= 12, "the table is not vacuous: authority accounts are recognised (owner, governance, guardian, sponsor, recipient)");
  check(contains(payerInstructions, "provision_page") and contains(payerInstructions, "provision_close_record") and contains(payerInstructions, "request_round_draw") and contains(payerInstructions, "apply_promotion"), "the payer instructions are provision_page, provision_close_record, request_round_draw and apply_promotion");
  for (name in ["set_pause", "withdraw_management", "withdraw_operations", "rotate_guardian", "stage_config_version", "claim_backer", "withdraw_simple"].vals()) {
    var has = false;
    switch (AuthorityTable.instruction(name)) { case (?ix) { for (a in ix.accounts.vals()) { if (a.isAuthority) { has := true } } }; case (null) {} };
    check(has, name # " carries an authority signer in the table");
  };

  // ---- 2. the keeper's step builders -----------------------------------------
  let programId = switch (Base58.decode(AuthorityTable.PROGRAM_ID)) { case (?b) { b }; case (null) { Debug.trap("program id") } };
  let a = Pda.addresses(programId);
  let fee = key(0xFE);
  let blockhash = key(0x11);
  let sysProgram = switch (Base58.decode("11111111111111111111111111111111")) { case (?b) { b }; case (null) { Debug.trap("sys") } };
  let backer = key(0xB1);
  let steps : [(Text, Tx.Instruction)] = [
    ("discover_rows", Planner.discoverIx(a, 1, 0, 2, func(_ : Nat64) : Blob { backer })),
    ("apply_senior", Planner.applySeniorIx(a, 1, ?backer)),
    ("seal_weights", Planner.sealWeightsIx(a, 1)),
    ("allocate_rows", Planner.allocateIx(a, 1, 0, 2, func(_ : Nat64) : Blob { backer })),
    ("prune_rows", Planner.pruneIx(a, 1, 8, 1, Planner.skippedPruneRow(a, 0))),
    ("commit_ticket", Planner.commitIx(a, 1, ?7)),
    ("expire_promotion", Planner.expireIx(a, 7, key(0xAF))),
    ("finalize_round", Planner.finalizeIx(a, 7)),
  ];
  check(steps.size() == Planner.SUPPORTED.size(), "every supported step is built here");
  for ((name, ix) in steps.vals()) {
    check(contains(Planner.SUPPORTED, name), name # " is in Planner.SUPPORTED");
    let tbl = switch (AuthorityTable.instruction(name)) { case (?t) { t }; case (null) { Debug.trap("no table row " # name) } };
    var anySigner = false;
    var anyAuthority = false;
    var anyPayer = false;
    for (acc in tbl.accounts.vals()) {
      if (acc.isSigner) { anySigner := true };
      if (acc.isAuthority) { anyAuthority := true };
      if (acc.name == "payer" or acc.name == "fee_payer") { anyPayer := true };
    };
    check(not anySigner and not anyAuthority and not anyPayer, name # ": the IDL gives it no signer, no authority and no payer account");
    check(ix.programId == programId, name # ": targets the native program");
    check(ix.accounts.size() >= tbl.accounts.size(), name # ": carries at least the IDL's fixed accounts");
    var shapeOk = true;
    var i : Nat = 0;
    while (i < tbl.accounts.size()) {
      let want = tbl.accounts[i];
      let got = ix.accounts[i];
      let placeholder = want.isOptional and got.key == programId and not got.isWritable;
      if (not placeholder and got.isWritable != want.isWritable) { shapeOk := false; Debug.print("  writable mismatch " # name # "." # want.name) };
      if (got.isSigner != want.isSigner) { shapeOk := false };
      switch (want.fixedAddress) { case (?_) { if (got.key != sysProgram) { shapeOk := false; Debug.print("  fixed address mismatch " # name # "." # want.name) } }; case (null) {} };
      i += 1;
    };
    check(shapeOk, name # ": account flags match the IDL positions");
    var noSigners = true;
    for (m in ix.accounts.vals()) { if (m.isSigner) { noSigners := false }; if (m.key == fee) { noSigners := false } };
    check(noSigners, name # ": no instruction account is a signer and none is the fee address");

    // Compile it the way the keeper does: budget instructions first, then the step.
    let all = Array.append(Tx.computeBudgetInstructions(200_000, 1_000), [ix]);
    let m = Tx.compile(fee, blockhash, all);
    check(m.accountKeys[0] == fee and m.numRequiredSignatures == 1, name # ": the fee address is message account 0 and the only signer");
    var feeCount : Nat = 0;
    for (k in m.accountKeys.vals()) { if (k == fee) { feeCount += 1 } };
    check(feeCount == 1, name # ": the fee address appears once among the message keys");
    var referenced = false;
    for (idxs in m.instructionAccountIndexes.vals()) { for (i in idxs.vals()) { if (i == 0) { referenced := true } } };
    for (p in m.programIdIndexes.vals()) { if (p == 0) { referenced := true } };
    check(not referenced, name # ": no instruction references the fee address (it pays the network fee only)");
  };
};

if (failures > 0) { Debug.trap("WrongAuthorityTablePayerIsAuthority.test.mo (negative control of authority.test.mo): " # debug_show (failures) # " check(s) FAILED") };
Debug.print("WrongAuthorityTablePayerIsAuthority.test.mo (negative control of authority.test.mo): ALL PASS");
