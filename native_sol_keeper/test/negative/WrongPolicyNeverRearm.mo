import Real "../../Policy";

/// NEGATIVE CONTROL module (generated by negative.py - do not edit). Written AFTER the implementation.
/// A valid module with the same public API as Policy.mo and ONE deliberate wrong behaviour:
/// the postupgrade decision never re-arms the timer
/// Everything not overridden below is an alias of the real Policy.
module {
    public let ALERT_AFTER_NS = Real.ALERT_AFTER_NS;
    public let SIGN_AFTER_NS = Real.SIGN_AFTER_NS;
    public type Input = Real.Input;
    public type Decision = Real.Decision;
    public let staleFor = Real.staleFor;
    public let decide = Real.decide;
    public type Level = Real.Level;
    public let level = Real.level;
    public let escalateIfDead = Real.escalateIfDead;
    public type Tracker = Real.Tracker;
    public let newTracker = Real.newTracker;
    public let observe = Real.observe;
    public let pollDelayNs = Real.pollDelayNs;
    public let due = Real.due;
    public let pruneWindow = Real.pruneWindow;
    public let signaturesInWindow = Real.signaturesInWindow;
    public let budgetAllows = Real.budgetAllows;
    public func rearmAfterUpgrade(s : { armed : Bool; configured : Bool }) : Bool {
        // BUG: postupgrade never re-arms, whatever the stable flag says.
        ignore s;
        false;
    };
    public type TimerState = Real.TimerState;
    public type TimerEvent = Real.TimerEvent;
    public type TimerAction = Real.TimerAction;
    public func timerStep(s : Real.TimerState, configured : Bool, e : Real.TimerEvent) : (Real.TimerState, Real.TimerAction) {
        // BUG: #PostUpgrade is a no-op; every other event is the real behaviour.
        switch (e) {
            case (#PostUpgrade) { (s, #None) };
            case (_) { Real.timerStep(s, configured, e) };
        };
    };
};
