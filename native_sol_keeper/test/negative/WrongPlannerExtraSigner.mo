import Real "../../Planner";
import Array "mo:base/Array";
import Pda "../../Pda";
import Tx "../../Tx";

/// NEGATIVE CONTROL module (generated by negative.py - do not edit). Written AFTER the implementation.
/// A valid module with the same public API as Planner.mo and ONE deliberate wrong behaviour:
/// commit_ticket and expire_promotion carry an extra signer account
/// Everything not overridden below is an alias of the real Planner.
module {
    public let SUPPORTED = Real.SUPPORTED;
    public let MAX_BATCH_ROWS = Real.MAX_BATCH_ROWS;
    public let computeUnitLimit = Real.computeUnitLimit;
    public type Step = Real.Step;
    public type Need = Real.Need;
    public type Plan = Real.Plan;
    public type View = Real.View;
    public let discoverIx = Real.discoverIx;
    public let applySeniorIx = Real.applySeniorIx;
    public let sealWeightsIx = Real.sealWeightsIx;
    public let allocateIx = Real.allocateIx;
    public let skippedPruneRow = Real.skippedPruneRow;
    public let pruneIx = Real.pruneIx;
    let EXTRA_SIGNER : Blob = "\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB\AB";
    func withExtraSigner(ix : Tx.Instruction) : Tx.Instruction {
        { ix with accounts = Array.append<Tx.Meta>(ix.accounts, [{ key = EXTRA_SIGNER; isSigner = true; isWritable = false }]) };
    };
    // BUG: an extra signer account is appended to the instruction.
    public func commitIx(a : Pda.Addresses, ticketId : Nat64, closeId : ?Nat64) : Tx.Instruction { withExtraSigner(Real.commitIx(a, ticketId, closeId)) };
    public func expireIx(a : Pda.Addresses, closeId : Nat64, ownerRefund : Blob) : Tx.Instruction { withExtraSigner(Real.expireIx(a, closeId, ownerRefund)) };

    public let finalizeIx = Real.finalizeIx;
    public let next = Real.next;
};
